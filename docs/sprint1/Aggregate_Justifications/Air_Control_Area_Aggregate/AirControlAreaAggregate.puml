@startuml AirControlAreaAggregate_SD
title Register an Air Control Area - US050
skinparam NoteBackgroundColor #FFFACD
skinparam NoteBorderColor #DAA520

actor BackOfficeOperator as User
participant "AirControlAreaUI" as UI
participant "AirControlAreaController" as Controller
participant "AirControlAreaService" as Service
database "AirControlAreaRepository" as DB

note over User: BackOfficeOperator is authenticated\nand has an active session

User -> UI: request air control area registration form
activate UI
UI --> User: show form
deactivate UI

User -> UI: submit(minFuelRequirement, geographicalBoundary)
activate UI
note left of UI
  airControlAreaForm:
  - minFuelRequirement
  - geographicBoundary
end note

UI -> Controller: registerAirControlArea(airControlAreaForm)
activate Controller

Controller -> Service: createAirControlArea(airControlAreaForm)
activate Service

Service -> DB: getNextAreaCode()
activate DB
DB --> Service: nextCode
deactivate DB

Service -> DB: findByAreaCode(nextCode)
activate DB
DB --> Service: Optional<AirControlArea>
deactivate DB

alt AreaCode collision detected
    Service --> Controller: AreaCodeCollisionException
    deactivate Service
    Controller --> UI: propagate error
    deactivate Controller
    UI --> User: display error message
    deactivate UI

else AreaCode is unique

    create participant "<<Value Object>>\nAreaCode" as ID
    Service -> ID: create(nextCode)
    activate ID
    note right of ID
      Invariant enforced at construction:
      Generated by system: must be a positive integer.
      Throws if generated value is invalid.
    end note
    ID --> Service: areaCode
    deactivate ID

    create participant "<<Value Object>>\nGeographicalBoundary" as geoBound
    Service -> geoBound: create(coords1, coords2, coords3, ...)
    activate geoBound
    note right of geoBound
      Invariant enforced at construction:
      Points must be within lat ∈ [-90, 90], lon ∈ [-180, 180];
      At least 3 GeoCoordinates required to form a polygon;
      No need to verify if boundaries overlap;
      Throws if invalid.
    end note
    geoBound --> Service: geographicalBoundary
    deactivate geoBound

    create participant "<<Value Object>>\nMinFuelRequirement" as minFuel
    Service -> minFuel: create(minFuelRequirement)
    activate minFuel
    note right of minFuel
      Invariant enforced at construction:
      Must be a positive number;
      Throws if invalid.
    end note
    minFuel --> Service: minFuelRequirement
    deactivate minFuel

    create participant "<<Aggregate Root>>\nAirControlArea" as AirControlArea
    Service -> AirControlArea: create(areaCode, minFuelRequirement, geographicalBoundary)
    activate AirControlArea
    AirControlArea --> Service: airControlArea
    deactivate AirControlArea

    Service -> DB: save(airControlArea)
    activate DB
    DB --> Service: savedAirControlArea
    deactivate DB

    Service --> Controller: success(savedAirControlArea)
    deactivate Service
    Controller --> UI: propagate success
    deactivate Controller
    UI --> User: confirm "Air Control Area [AREACODE] registered successfully"
    deactivate UI

end

@enduml